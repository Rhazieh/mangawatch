# Copy this file to .env and fill in the values before running the app.
# Never commit .env to git.

# ── Required ──────────────────────────────────────────────────────────────────

# Long random string used to sign JWTs. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# PostgreSQL connection string. Pre-filled for docker-compose use.
# Override when running outside Docker.
DATABASE_URL=postgresql://mangawatch:mangawatch@localhost:5432/mangawatch

# ── Optional ──────────────────────────────────────────────────────────────────

# Public base URL of the app — used in password reset emails.
APP_BASE_URL=http://localhost:8000

# SendGrid API key for password reset emails.
# Leave blank to log reset links to stdout instead (development mode).
SENDGRID_API_KEY=

# From address for outgoing emails.
EMAIL_FROM=noreply@mangawatch.app

# Discord incoming webhook URL for DevOps alerts (new chapters, poll errors).
# Leave blank to disable Discord alerts.
DISCORD_WEBHOOK_URL=

# Polling intervals in seconds (defaults match ADR-0001).
POLL_INTERVAL_MANGADEX=1800
POLL_INTERVAL_SCRAPE=7200
